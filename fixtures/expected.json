{
  "01-messy-headers.tsv": {
    "mapping": {
      "Company Name": "company",
      "Position Title": "role",
      "Current Status 🙃": "status",
      "Date Applied (mm/dd)": "appliedDate",
      "Interview?": "interviewFlag",
      "Notes": "notes",
      "Link": "notes|null"
    },
    "notes": "Sheets paste with a title row, padded/emoji headers and junk columns"
  },
  "02-missing-dates.csv": {
    "mapping": {
      "Company": "company",
      "Role": "role",
      "Date": "appliedDate",
      "Status": "status"
    },
    "notes": "~45% blank or unreadable dates"
