    "mapping": {
      "Employer": "company",
      "Job Title": "role",
      "Applied On": "appliedDate",
      "Outcome": "status"
    },
    "notes": "Free-text and ambiguous statuses"
  },
  "04-duplicates.csv": {
    "mapping": {
      "company": "company",
      "role": "role",
      "applied": "appliedDate",
      "status": "status"
    },
    "notes": "3 exact duplicates, spelling variants, similar-but-distinct names"
  },
  "05-tiny.csv": {
    "mapping": {
      "Company": "company",
      "Status": "status"
    },
    "notes": "4 rows, no dates or roles"
  },
  "06-large-300.csv": {
    "mapping": {
      "Company": "company",
      "Position": "role",
      "Date Applied": "appliedDate",
      "Status": "status",
      "Interview Date": "interviewDate"
    },
    "notes": "300 rows with interview dates"
  },
  "07-zero-offers.csv": {
    "mapping": {
      "Company": "company",
      "Role": "role",
      "Date Applied": "appliedDate",
      "Status": "status"
    },
    "notes": "No offers recorded"
  },
  "08-mostly-unanswered.csv": {
    "mapping": {
      "Company": "company",
      "Role": "role",
      "Applied": "appliedDate",
      "Status": "status"
    },
    "notes": "~85% no recorded response; several recent"
  },
  "09-no-header-dmy.tsv": {
    "mapping": {
      "Column A": "company",
