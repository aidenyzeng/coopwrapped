# Public URL of the deployment. Printed on cards and used for absolute OG URLs.
# The default "cowrapped.app" is a PLACEHOLDER — set this before launch.
NEXT_PUBLIC_SITE_URL=https://cowrapped.app

# Share-link storage (required for share links on serverless hosts like Vercel).
# Without these, links are stored as JSON files under .data/shares (local/self-hosted only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional analytics collector. Receives allowlisted events via sendBeacon (JSON).
# Unset = development adapter (in-memory + console in dev).
NEXT_PUBLIC_ANALYTICS_ENDPOINT=
